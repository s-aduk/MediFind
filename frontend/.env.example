# Copy this to .env.local and fill in with your deployed stack's values.
# Get these from `sam deploy` output, or:
#   aws cloudformation describe-stacks --stack-name <your-stack-name> --query "Stacks[0].Outputs"

# From stack output "ApiUrl" - must end in a trailing slash.
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev/

# From stack output "UserPoolId"
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx

# From stack output "UserPoolClientId"
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# The AWS region you deployed the stack to (matches the region in the two values above).
NEXT_PUBLIC_COGNITO_REGION=us-east-1
