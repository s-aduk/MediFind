# .env.example - Copy to .env and fill in actual values

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=mediFind-dev

# Cognito Configuration (for local testing)
COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
COGNITO_CLIENT_ID=exampleclientid
COGNITO_IDENTITY_POOL_ID=us-east-1:EXAMPLE-POOL-ID

# API Configuration (when running locally)
API_GATEWAY_URL=http://localhost:3000/dev

# Feature Flags
ENABLE_AUTH=true
ENABLE_CACHING=false
LOG_LEVEL=debug

# DynamoDB Local (if using for development)
DYNAMODB_ENDPOINT=http://localhost:8000
